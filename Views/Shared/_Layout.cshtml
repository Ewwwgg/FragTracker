<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FragTracker</title>
    <!-- Basic Bootstrap, usually generated by dotnet new -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #0b0f19;
            color: #e0e6ed;
            font-family: 'Segoe UI', Consolas, monospace;
        }
        .navbar-cyber {
            background-color: #05080f !important;
            border-bottom: 2px solid #00ffcc;
        }
        .nav-link { letter-spacing: 1px; }
        .footer-cyber { border-top: 1px dashed #ff007f; margin-top: 50px; paddingTop: 20px; color: #555; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark navbar-cyber mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index" style="color: #00ffcc; font-weight: bold;">[ FRAG::TRACKER ]</a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Players" asp-action="Index" style="color: #ff007f;">Manage Players</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-cyber text-center">
        <div class="container">
            &copy; 2026 - FragTracker ESports Inc. - SYSTEM ONLINE
        </div>
    </footer>
</body>
</html>
