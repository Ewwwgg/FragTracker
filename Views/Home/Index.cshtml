@{
    ViewData["Title"] = "FragTracker Dashboard";
}

<style>
    /* Дизайн у стилі Steam */
    body {
        background-color: #1b2838;
        color: #c6d4df;
        font-family: Arial, Helvetica, sans-serif;
    }
    .steam-container {
        background: linear-gradient(135deg, #1e2f42 0%, #17212e 100%);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
        padding: 2.5rem;
        border-radius: 4px;
        margin-top: 30px;
    }
    .steam-header {
        color: #ffffff;
        letter-spacing: 1px;
        font-weight: 300;
        text-transform: uppercase;
        font-size: 28px;
        margin-bottom: 20px;
    }
    .alert-panel {
        background-color: rgba(0, 0, 0, 0.4);
        padding: 20px;
        margin: 20px 0;
        border-radius: 4px;
    }
    .status-badge {
        display: inline-block;
        padding: 4px 8px;
        background: #5c7e10;
        color: #d2efa9;
        border-radius: 2px;
        font-size: 0.85rem;
    }
    .section-title {
        color: #66c0f4;
        font-weight: normal;
        margin-bottom: 10px;
    }
    .terminal-box {
        background-color: #1e2024;
        border-left: 2px solid #66c0f4;
        padding: 15px;
        color: #8f98a0;
        text-align: left;
    }
</style>

<div class="text-center steam-container">
    <h1 class="steam-header">FragTracker Core</h1>
    <p class="lead" style="color: #8f98a0; font-size: 14px;">Статистика та інфраструктура CS2 / Dota 2.</p>
    
    <div class="alert-panel text-left">
        <h4 class="section-title">ПОТОЧНИЙ ТУРНІР: <span style="color: #ffffff;">@ViewBag.TournamentName</span></h4>
        <p style="font-size: 14px; color: #8f98a0;">Статус інфраструктури: <span class="status-badge">@ViewBag.ServerEnvironment</span></p>
    </div>

    <div class="terminal-box">
        <h5 style="color: #66c0f4; font-size: 14px; text-transform: uppercase;">Мережевий шлюз Steam</h5>
        <div style="color: @(ViewBag.TokenMasked == null ? "#ff4444" : "#c6d4df")">
            > @ViewBag.SteamStatus
        </div>
        @if (ViewBag.TokenMasked != null)
        {
            <div style="color: #5c7e10; margin-top: 10px;">
                > @ViewBag.TokenMasked
            </div>
        }
    </div>
</div>
